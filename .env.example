# ---------------------------------------------------------------------------
# Policy Gatekeeper — Pharos Atlantic testnet configuration
#
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# The private key never leaves this machine and is never printed or logged.
# ---------------------------------------------------------------------------

# Required ONLY for `npm run testnet:transfer` (live broadcast mode).
# 0x-prefixed, 64 hex characters. Keep this key funded with testnet PHRS only.
PHAROS_TESTNET_PRIVATE_KEY=

# Recipient of the live testnet transfer. Must also be added to the policy
# allowlist (see POLICY_PATH below) or the Policy Gatekeeper will DENY the send.
PHAROS_TESTNET_RECIPIENT=

# Amount in PHRS (decimal, up to 18 fractional digits). Default: 0.001
PHAROS_TESTNET_AMOUNT=0.001

# Optional. Defaults to the official Pharos Atlantic testnet RPC.
PHAROS_TESTNET_RPC_URL=https://atlantic.dplabs-internal.com

# Required. Must be exactly 688689 (Pharos Atlantic testnet chain ID).
PHAROS_TESTNET_CHAIN_ID=688689

# Read-only simulation mode (`npm run simulate:testnet`) uses the private key
# only to derive a sender address. If you do not want to provide a key, set a
# plain sender address here instead (no secret involved):
PHAROS_TESTNET_SENDER=

# Policy file used by simulation and live transfer (validated, fail-closed).
POLICY_PATH=examples/policy.example.json

# Append-only audit log (JSON Lines). One record per policy decision / execution.
AUDIT_PATH=audit/audit.jsonl
